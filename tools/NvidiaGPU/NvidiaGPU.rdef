/*
 * NvidiaGPU.rdef - Resource definitions for NvidiaGPU app
 */

resource app_signature "application/x-vnd.NvidiaGPU";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_ALPHA,
	internal = 0,
	short_info = "NvidiaGPU",
	long_info = "NVIDIA GPU Monitor for Haiku"
};

resource(1, "BEOS:FILE_TYPES") message {
	"types" = "application/x-vnd.Be-elfexecutable"
};

